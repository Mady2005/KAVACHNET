ENVIRONMENT=development
SECRET_KEY=replace-with-a-long-random-secret-before-deployment
DATABASE_URL=sqlite:///./kavachnet.db
ACCESS_TOKEN_MINUTES=30
COOKIE_SECURE=false
REGISTRATION_ENABLED=false
ALLOWED_ORIGINS=http://localhost:5173
NETWORK_MAX_PAYLOAD_BYTES=65536
NETWORK_MESSAGE_TTL_SECONDS=604800
NETWORK_RETRY_LIMIT=5
NETWORK_RETRY_BASE_SECONDS=5
NETWORK_RETRY_MAX_SECONDS=300
NETWORK_WORKER_POLL_SECONDS=1
NETWORK_LATENCY_REFERENCE_MS=500
NETWORK_BANDWIDTH_REFERENCE_MBPS=100
NETWORK_HEALTHY_THRESHOLD=70
NETWORK_HEALTH_LATENCY_WEIGHT=0.35
NETWORK_HEALTH_DELIVERY_WEIGHT=0.40
NETWORK_HEALTH_BANDWIDTH_WEIGHT=0.25
NETWORK_MEASUREMENT_ENABLED=false
NETWORK_MEASUREMENT_TARGET_URL=
NETWORK_MEASUREMENT_TARGET_LABEL=
NETWORK_MEASUREMENT_TIMEOUT_SECONDS=3
NETWORK_MEASUREMENT_INTERVAL_SECONDS=1
NETWORK_MEASUREMENT_MAX_SAMPLES=20
NETWORK_ACK_TEST_URL=
NETWORK_THROUGHPUT_TEST_URL=
NETWORK_THROUGHPUT_MAX_BYTES=1048576
NETWORK_THROUGHPUT_MAX_SECONDS=5
RIPE_ATLAS_ENABLED=false
RIPE_ATLAS_MEASUREMENT_ID=
RIPE_ATLAS_TIMEOUT_SECONDS=10
RIPE_ATLAS_MAX_RESULTS=500
RIPE_ATLAS_LOOKBACK_HOURS=24
